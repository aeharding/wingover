opt_out_usage

default_platform(:ios)

APP_IDENTIFIER = "app.wingover.wingover"

platform :ios do
  desc "Build via tauri ios build, export manually, push to TestFlight"
  lane :deploy do
    setup_ci if ENV["CI"]
    # Installs the shared distribution cert + profile into the CI keychain.
    # Cert AND profile from the match cache. When the App ID gains a
    # capability (Sign in with Apple, 2026-07-15), the cached profile goes
    # stale and export fails with "profile doesn't include the X capability".
    # CI cannot fix that itself — its token's push to voyager-match 403s —
    # so the fix is one command on a Mac with repo write access:
    #
    #   bundle exec fastlane match appstore \
    #     --app_identifier app.wingover.wingover --force
    #
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key_path: "authkey.json",
    )

    build_number = ENV.fetch("BUILD_NUMBER", "1")
    root = File.expand_path("..", __dir__)

    # tauri ios build owns the archive (frontend build + xcodebuild with the
    # context its Rust phase expects), but its export step insists on cloud
    # signing, which our API key cannot do — tolerate that failure and
    # export the archive ourselves with the match profile.
    sh("cd '#{root}' && pnpm tauri ios build " \
       "--export-method app-store-connect --build-number #{build_number} " \
       "|| true")

    archive = File.join(root, "src-tauri/gen/apple/build/wingover_iOS.xcarchive")
    UI.user_error!("Archive missing: tauri build failed before export — check its log above") unless File.directory?(archive)

    export_dir = File.join(root, "build-export")
    sh("xcodebuild -exportArchive " \
       "-archivePath '#{archive}' " \
       "-exportOptionsPlist '#{File.join(root, "fastlane/export-options.plist")}' " \
       "-exportPath '#{export_dir}'")

    ipa = Dir[File.join(export_dir, "*.ipa")].first
    UI.user_error!("No IPA produced by exportArchive") unless ipa

    # Voyager-style distribution: internal testers get the build the moment
    # processing finishes; the "Public Testers" external group (the
    # testflight.apple.com/join/aaH9CJef link) gets it after Beta App Review.
    # The group name must match App Store Connect exactly or this step fails
    # after the upload. reject_build_waiting_for_review keeps a superseded
    # build from holding the review slot when the next merge lands.
    upload_to_testflight(
      ipa: ipa,
      app_identifier: APP_IDENTIFIER,
      api_key_path: "authkey.json",
      distribute_external: true,
      groups: ["Public Testers"],
      changelog: "GitHub Actions build #{build_number}, ref #{ENV['GITHUB_REF']}, sha #{ENV['GITHUB_SHA']}, msg #{ENV['COMMIT_MSG']}",
      reject_build_waiting_for_review: true,
    )
  end

  desc "Upload the committed App Store screenshots (screenshots only, no binary, no metadata text)"
  lane :screenshots do
    # Screenshots are generated locally (`pnpm screenshots`) and committed under
    # fastlane/screenshots/en-US; this lane only uploads them. deliver sorts by
    # image dimensions into device classes (iPhone 6.9", iPad 13"). No Xcode or
    # signing needed — it is a pure App Store Connect API upload.
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      api_key_path: "authkey.json",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      # Non-interactive: no HTML preview confirmation prompt in CI.
      force: true,
    )
  end
end
